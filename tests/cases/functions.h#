pub fn fact(n: int) -> int is
    if n <= 1 is
        return 1
    end
    return n * fact(n - 1)
end

fn double(x: int) -> int = x * 2

fn between(v: int, lo: int, hi: int) -> bool is
    return v >= lo && v <= hi
end

fn main() is
    write("fact(10) = " + to_string(fact(10)))
    write("double(21) = " + to_string(double(21)))
    write(between(5, 1, 10))
    write(between(50, 1, 10))
    write(!between(50, 1, 10))
end
